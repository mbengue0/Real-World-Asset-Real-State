# Copy this file to .env at the project root and at /contracts/.env
# DO NOT commit .env — it is gitignored.

# ─── Sepolia RPC ────────────────────────────────────────────────
# Get a free RPC URL from Alchemy (https://alchemy.com) or Infura (https://infura.io).
# Format: https://eth-sepolia.g.alchemy.com/v2/<your-api-key>
SEPOLIA_RPC_URL=

# ─── Deployer wallet ───────────────────────────────────────────
# Private key of a FRESH dev wallet funded with Sepolia test ETH.
# Never use a wallet that holds real assets. No 0x prefix.
DEPLOYER_PRIVATE_KEY=

# ─── Etherscan verification ────────────────────────────────────
# Free API key from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ─── Pinata (IPFS pinning) ─────────────────────────────────────
# Sign up at https://app.pinata.cloud — use a "JWT" auth token.
# Frontend reads VITE_PINATA_JWT; admin-only flows.
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ─── Deployed contract addresses (filled in after Sepolia deploy) ──
VITE_PAYMENT_TOKEN_ADDRESS=
VITE_PROPERTY_FACTORY_ADDRESS=
VITE_SEPOLIA_RPC_URL=
