# Copy to contracts/.env (gitignored). Read by hardhat.config.ts via dotenv.
# Only the three Sepolia-deploy variables go here.

# Sepolia RPC URL — from alchemy.com or infura.io
# Format: https://eth-sepolia.g.alchemy.com/v2/<your-key>
SEPOLIA_RPC_URL=


# Private key of a FRESH dev wallet that holds Sepolia ETH for gas
# NO `0x` prefix. NEVER use a wallet with real assets.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key — free from etherscan.io/myapikey
ETHERSCAN_API_KEY=
