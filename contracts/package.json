{
  "name": "rwa-realestate-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Smart contracts for RWA real-estate tokenization — DAUST Spring 2026 final project",
  "scripts": {
    "compile": "hardhat compile && npm run sync:abi",
    "sync:abi": "ts-node scripts/sync-abi.ts",
