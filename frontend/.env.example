# Copy to frontend/.env (gitignored). Vite exposes VITE_* vars to the browser.

# Which chain the dApp targets. 11155111 = Sepolia, 31337 = local Hardhat.
VITE_CHAIN_ID=11155111

# Sepolia RPC fallback (used when the connected wallet's chain doesn't have one).
# Get from alchemy.com or infura.io. Format: https://eth-sepolia.g.alchemy.com/v2/<key>
VITE_SEPOLIA_RPC_URL=

# Deployed contract addresses — fill in after `npm run deploy:sepolia`.
VITE_PAYMENT_TOKEN_ADDRESS=
VITE_PROPERTY_FACTORY_ADDRESS=

# Pinata (IPFS pinning). JWT is used only by admin flows (mint, list property).
# Sign up at app.pinata.cloud → API Keys → New Key → copy the JWT.
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
